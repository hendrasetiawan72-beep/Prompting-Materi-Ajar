# GROQ_API_KEY: Penyedia AI utama (Groq). Dapatkan di https://console.groq.com/keys
# Cukup isi salah satu antara GROQ_API_KEY atau GEMINI_API_KEY.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Penyedia AI cadangan (Gemini API).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER (opsional): auto (Groq lalu Gemini, default) | groq | gemini
# AI_PROVIDER="auto"

# GROQ_MODEL / GROQ_FALLBACK_MODEL (opsional): ganti model Groq tanpa mengubah kode.
# Default: openai/gpt-oss-120b dan openai/gpt-oss-20b
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
